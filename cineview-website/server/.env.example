# ---------- Server ----------
NODE_ENV=development
PORT=4000

# MongoDB connection string (local, or MongoDB Atlas: mongodb+srv://user:pass@cluster/cineview)
MONGO_URI=mongodb://127.0.0.1:27017/cineview

# Allowed website origins (comma-separated, no trailing slash).
# Development defaults to http://localhost:5173 and http://localhost:4173 when empty.
CORS_ORIGINS=

# Number of reverse proxies in front of the API (0 = none; Render/Railway/Nginx/Cloudflare = 1).
# Required for correct per-client rate limiting behind a proxy.
TRUST_PROXY=0

# Contact form rate limit per client IP
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MINUTES=15

# Random secret used to hash client IPs (raw IPs are never stored). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=

# ---------- Email notifications ----------
# Leave SMTP_HOST empty to disable emails (requests are still saved).
# Recipient(s), comma-separated
CONTACT_NOTIFICATION_EMAIL=
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS). Leave empty to auto-detect from the port.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender, e.g. "Cineview Website <no-reply@your-domain.com>" (must be allowed by your SMTP provider)
SMTP_FROM=
# Timezone used for the date in notification emails
NOTIFICATION_TIMEZONE=Asia/Riyadh

# ---------- Admin API (optional) ----------
# Enables /api/admin/* for the future admin dashboard. Minimum 32 characters. Empty = disabled.
ADMIN_API_KEY=
