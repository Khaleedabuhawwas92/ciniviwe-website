# Public URL of the deployed site (no trailing slash).
# Used for the canonical link and Open Graph URL. Example: https://www.example.com
VITE_SITE_URL=

# Endpoint that receives contact form submissions as JSON (POST).
# Works with your own API or services such as Formspree / Getform.
# Leave empty until a backend is ready: the form will then offer WhatsApp / email instead.
VITE_CONTACT_ENDPOINT=
