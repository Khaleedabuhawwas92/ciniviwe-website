# Cineview admin dashboard — PUBLIC build-time settings only.
# Everything here ends up in the browser bundle: never put secrets, API keys or passwords in VITE_* variables.

# API base URL including /api (no trailing slash). Production example: https://api.your-domain.com/api
VITE_API_URL=http://localhost:4000/api

# Optional: country calling code (digits only, e.g. 966) used to build WhatsApp links for phone numbers
# saved in local format (starting with 0). Numbers saved with + or 00 always work. Empty = no guessing.
VITE_DEFAULT_COUNTRY_CODE=
