# Public URL of the deployed site (no trailing slash).
# Used for the canonical link and Open Graph URL. Example: https://www.example.com
VITE_SITE_URL=

# Base URL of the Cineview API (see /server), no trailing slash. Example: https://api.example.com
# Leave empty when the API is reachable on the same domain under /api.
# In local development leave it empty: Vite proxies /api to http://localhost:4000.
# Only public values belong here — never put secrets in VITE_* variables.
VITE_API_URL=
