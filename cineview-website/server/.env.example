# Copy to server/.env and fill in. Never commit real values.

# ---------- Server ----------
NODE_ENV=development
PORT=4000

# MongoDB connection string (local, or MongoDB Atlas: mongodb+srv://user:pass@cluster/cineview)
MONGO_URI=mongodb://127.0.0.1:27017/cineview

# Allowed browser origins: the website AND the admin dashboard (comma-separated, no trailing slash, never "*").
# Empty in development = http://localhost:5173, :5174, :4173, :4174.
# Production example: https://cineview.com,https://www.cineview.com,https://admin.cineview.com
CORS_ORIGINS=

# Number of reverse proxies in front of the API (0 = none; Render/Railway/Nginx/Cloudflare = 1).
# Required for correct per-client rate limiting behind a proxy.
TRUST_PROXY=0

# Timezone for dashboard statistics ("today", "this month"), date filters and email dates
APP_TIMEZONE=Asia/Riyadh

# ---------- Public contact form ----------
# Rate limit per client IP
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MINUTES=15

# Random secret used to hash client IPs (raw IPs are never stored). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=

# ---------- Email notifications ----------
# Leave SMTP_HOST empty to disable emails (requests are still saved).
# Recipient(s), comma-separated
CONTACT_NOTIFICATION_EMAIL=
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS). Leave empty to auto-detect from the port.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender, e.g. "Cineview Website <no-reply@your-domain.com>" (must be allowed by your SMTP provider)
SMTP_FROM=

# ---------- Admin dashboard authentication ----------
# Signs short-lived access tokens. REQUIRED in production, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# (In development a temporary secret is used when empty.)
ADMIN_JWT_SECRET=
# Access token lifetime (kept in memory by the dashboard) and session lifetime (httpOnly refresh cookie).
# Refresh tokens are random, stored only as SHA-256 hashes and rotated on every use — no secret needed.
ADMIN_ACCESS_EXPIRES=15m
ADMIN_REFRESH_EXPIRES=7d
# Refresh cookie: secure defaults to true in production. SameSite "strict" works when the admin app and API
# share a site (admin.example.com + api.example.com). Use "none" (+ secure) only for different sites.
ADMIN_COOKIE_SECURE=
ADMIN_COOKIE_SAMESITE=strict
ADMIN_COOKIE_DOMAIN=
# Failed login attempts allowed per IP and per account within the window
ADMIN_LOGIN_RATE_LIMIT_MAX=10
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
# bcrypt cost factor
ADMIN_BCRYPT_ROUNDS=12

# ---------- First SUPER_ADMIN (used only by `npm run admin:create`) ----------
# Optional: anything left empty is asked interactively. Remove the password after the account is created.
ADMIN_INITIAL_NAME=
ADMIN_INITIAL_USERNAME=
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
